# Environment Variables Template for FarmFreshAqua
# Copy this file to .env for local development
# In Render: Set these in Dashboard -> Environment Variables

# PostgreSQL Database Connection URL
# On Render: Injected automatically when you attach Render PostgreSQL
DATABASE_URL=postgresql+psycopg2://username:password@hostname:5432/database_name

# Secret Key for JWT Token Authentication (Minimum 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret_key

# Allowed CORS Origins (comma-separated list of frontends that can make requests)
ALLOWED_ORIGINS=https://farmfresh-frontend.onrender.com,http://localhost:3000

# Environment Mode
ENVIRONMENT=production
