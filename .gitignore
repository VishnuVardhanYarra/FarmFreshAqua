# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.pyd

# Environments & Virtual Envs
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads & User generated content (preserve directory with .gitkeep)
uploads/*
!uploads/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and databases
*.log
*.sqlite
*.sqlite3
.pytest_cache/
